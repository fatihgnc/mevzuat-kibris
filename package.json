    "ingest:entities": "tsx scripts/extract-entities/index.ts",
    "ingest:daily": "tsx scripts/daily/index.ts",
    "alerts:dispatch": "tsx scripts/dispatch-alerts/index.ts",
    "revalidate": "tsx scripts/revalidate/index.ts",
    "db:migrate": "tsx scripts/migrate/index.ts",
    "db:seed": "tsx scripts/seed/index.ts",
    "db:reset": "tsx scripts/migrate/index.ts --reset && tsx scripts/seed/index.ts"
  },
  "dependencies": {
