# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Veritabani — IKI AYRI BAGLANTI, ikisi de gerekli (Supabase kullaniyorsaniz).
#
# Migration ve ingest SESSION modu istiyor: migration DDL calistiriyor, ingest
# uzun islem tutuyor. Uygulama ise tam tersini istiyor — Vercel'de her lambda
# kendi baglantisini aciyor — ve Supabase'in session pooler'i 15 istemciyle
# sinirli. Tek URL kullanildiginda `next build` bu tavana carpip patliyor
# (3.399 sayfayi ~8 isci uretiyor, her biri kendi havuzunu aciyor).
#
# Session pooler ya da dogrudan baglanti, port 5432 — migration + ingest icin.
# VERCEL'DE DE ZORUNLU: `next build` prerender'i bu URL ile yapiyor, cunku
# transaction pooler derleme sirasinda cevap kaybediyor (HANDOFF S6.4). Yalnizca
# DATABASE_URL_POOLED tanimlanirsa derleme sessizce transaction pooler'a duser
# ve prerender asilir.
DATABASE_URL=
# Transaction pooler, port 6543 — uygulamanin CALISMA ZAMANI okuma baglantisi.
# Ayni host ve kullanici, yalnizca port farkli. Bos birakilirsa DATABASE_URL'e
# dusuluyor; yerel Postgres'te pooler olmadigi icin dogrusu da bu.
DATABASE_URL_POOLED=

# Resend
# Ayni anahtar iki yerde kullaniliyor: (1) burada, alarm gonderimi icin
# (scripts/dispatch-alerts, GitHub Actions'ta kosuyor -- Vercel'e GEREKMEZ);
# (2) Supabase Auth'un Custom SMTP alanina, magic link icin.
RESEND_API_KEY=
# Gonderen alan adi Resend'de DOGRULANMIS olmali. mevzuatkibris.com henuz
# alinmadi, dolayisiyla su an calisan deger asagidaki sandbox adres --
# yalnizca Resend hesabinin kendi e-postasina gonderebilir. Alan adi
# dogrulaninca bildirim@<alanadi> yapilacak.
RESEND_FROM="Mevzuat Kıbrıs <onboarding@resend.dev>"

# LLM ozet katmani (spec 3.8 ikinci basamak) — `npm run summarize`
# Anahtar yoksa betik calismiyor; kural katmani ve ingest etkilenmiyor.
OPENAI_API_KEY=
# Varsayilan gpt-4o-mini. Tek seferlik bir doldurma isi; model dogrudan maliyeti belirliyor.
OPENAI_MODEL=
# Uyumlu bir vekil/gateway kullaniliyorsa; bos birakilirsa https://api.openai.com/v1
OPENAI_BASE_URL=
# Dakikada token tavani (TPM). Bos birakilirsa 200000 (gpt-4o-mini varsayilan katmani).
# Betik istek basina ~1000 token harcadigi icin bu deger dogrudan hizi belirliyor;
# katmanin daha yuksekse yaz, yoksa 429 yiyip yeniden denemekle vakit kaybeder.
OPENAI_TPM=

# On-demand revalidation
REVALIDATE_SECRET=

# Abonelikten cikma baglantisinin HMAC imzasi (bos birakilirsa REVALIDATE_SECRET kullanilir)
ALERT_UNSUBSCRIBE_SECRET=

# Site (preview deployment'larda boş bırak; robots noindex devreye girer)
NEXT_PUBLIC_SITE_URL=https://mevzuatkibris.com
NEXT_PUBLIC_VERCEL_ENV=

# İletişim (kaynak siteye gönderilen User-Agent içinde kullanılır)
CONTACT_EMAIL=iletisim@mevzuatkibris.com

# AdSense (boşsa reklam basılmaz)
NEXT_PUBLIC_ADSENSE_CLIENT=
NEXT_PUBLIC_ADSENSE_SLOT_HOME=
NEXT_PUBLIC_ADSENSE_SLOT_FEED=
NEXT_PUBLIC_ADSENSE_SLOT_ARTICLE=
